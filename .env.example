# Neo4j — the knowledge graph (local, Homebrew)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag-poc
NEO4J_DATABASE=neo4j

# Postgres — core store + per-practitioner vaults (specs/v6, local Homebrew)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=clinic

# Filesystem — uploaded files kept byte-for-byte alongside the chunks
ORIGINALS_PATH=data/originals

# Chunked-upload staging (app/uploads.py) — swept for abandoned uploads
UPLOAD_STAGING_PATH=data/upload-staging
MAX_UPLOAD_BYTES=209715200

# Nebius token factory — OpenAI-compatible (specs/v4.2). One shared
# server-side key for every practitioner's LLM calls.
NEBIUS_API_KEY=v1....
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# The AI team — six roles (specs/v4.2/01). Defaults are the human-readable
# names as given when this was specced — confirm each against Nebius's
# actual catalog ID (typically namespaced, e.g. "Qwen/Qwen3-32B") before
# deploying; using the bare label verbatim is a real, first-try failure
# mode (every real call 404s), not hypothetical.
READER_MODEL=Qwen3.6-27B
GRAPH_BUILDER_MODEL=MedGemma-27B
EMBEDDER_MODEL=Qwen3-Embedding-8B
RETRIEVAL_MODEL=Qwen3-8B
REASONER_MODEL=KIMI-K3
# Not a chat model — a local hallucination-detection classifier (HHEM-2.1-
# Open) run via transformers/torch, not a Nebius catalog id. See
# specs/v4.2/01 for why, and requirements.txt for the CPU-only torch note.
CHECKER_MODEL=vectara/hallucination_evaluation_model
CHECKER_THRESHOLD=0.5
# Qwen3-Embedding-8B's real output dimension — must match exactly or the
# Neo4j vector index creation fails outright.
EMBEDDING_DIMENSIONS=4096

# Per-role base_url/api_key overrides (app/clients/llm_client.py) — every
# role defaults to NEBIUS_API_KEY/NEBIUS_BASE_URL above; set one of these
# only when that specific role needs a different provider/deployment.
# READER_BASE_URL=
# READER_API_KEY=
# GRAPH_BUILDER_BASE_URL=
# GRAPH_BUILDER_API_KEY=
# EMBEDDER_BASE_URL=
# EMBEDDER_API_KEY=
# RETRIEVAL_BASE_URL=
# RETRIEVAL_API_KEY=
# REASONER_BASE_URL=
# REASONER_API_KEY=

# Ingestion — passages are the citable unit
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Retrieval — the grade threshold below which a source is invisible to
# graph traversal (app/retrieval/), overridable per-practitioner via
# their own source weights.
MIN_GRADE=7

# Graph-traversal retrieval (app/retrieval/) — TRAVERSAL_MAX_DEPTH is a
# circuit breaker against runaway cost/depth, not the primary stopping
# logic (the frontier actually emptying is).
TRAVERSAL_MAX_DEPTH=5
TRAVERSAL_MAX_CANDIDATES_PER_HOP=20
TRAVERSAL_SEED_TOP_K=10
