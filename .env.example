# Neo4j — the knowledge library (local, Homebrew)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag-poc
NEO4J_DATABASE=neo4j

# SQLite — the patient vault
SQLITE_PATH=data/patients.db

# Filesystem — uploaded files kept byte-for-byte alongside the chunks
ORIGINALS_PATH=data/originals

# Chunked-upload staging (app/uploads.py) — swept for abandoned uploads
UPLOAD_STAGING_PATH=data/upload-staging
MAX_UPLOAD_BYTES=209715200

# Anthropic — the AI team
ANTHROPIC_API_KEY=sk-ant-...
READER_MODEL=claude-haiku-4-5
LIBRARIAN_MODEL=claude-sonnet-5
ANSWER_MODEL=claude-opus-5
CHECKER_MODEL=claude-haiku-4-5

# Nebius token factory — OpenAI-compatible, drafted as specs/v4.2 (not yet
# wired into app/llm.py)
NEBIUS_API_KEY=v1....
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Ingestion — passages are the citable unit
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Retrieval — the librarian picks from source cards; no embeddings
MIN_GRADE=7
MAX_SOURCES=100
MAX_PASSAGES=120
