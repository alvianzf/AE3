# Empty in production — FastAPI serves the build from the same origin
# (specs/v4/01-sveltekit-frontend.md#data-layer), so a relative /api/...
# path is correct.
PUBLIC_API_BASE=

# Only used during `npm run build` (Node-side prerendering has no browser
# same-origin to rely on) — point this at wherever FastAPI is actually
# reachable while building, typically http://127.0.0.1:8000 on the same
# box the build runs on.
PUBLIC_API_BASE_BUILD=http://127.0.0.1:8000
